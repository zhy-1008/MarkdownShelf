{
  "version": 3,
  "configurePresets": [
    {
      "name": "win-x64",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>"
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "win-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-x64-release",
      "inherits": "win-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "win-x64-debug", "configurePreset": "win-x64-debug" },
    { "name": "win-x64-release", "configurePreset": "win-x64-release" }
  ],
  "testPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
